# Bu dosyayi .env olarak kopyalayip degerleri doldurun (.env git'e gitmez).

# Deepgram (konusmadan metne / STT). Konsoldan alin: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Konusulan dil: tr, en, en-US, de, fr, es ... ya da "auto" (otomatik tespit)
DEEPGRAM_LANGUAGE=tr
# Arayuz dili: tr / en
UI_LANGUAGE=tr

# Bas-konus tusu (orn. f8, f9, "right ctrl"). detect_key.py ile butonu ogrenebilirsiniz.
PTT_HOTKEY=f8
DICTATE_AUTO_PASTE=1
DICTATE_AUTO_ENTER=0

# --- Sadece opsiyonel sesli ajan (agent.py) icin; dikte/tray bunlari kullanmaz ---
# ANTHROPIC_API_KEY=
# MODEL=claude-sonnet-4-6
